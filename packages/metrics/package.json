{
  "name": "@magicode/metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Análisis local de cambios IA: importancia, redundancia y automatización (sin enviar código).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {

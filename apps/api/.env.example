# ── MagiCode API (apps/api) — copia a apps/api/.env para desarrollo local ──
APP_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=*

# DynamoDB single-table (keys.ts). Local: dynamodb-local del docker-compose.
TABLE_NAME=magicode-dev-productivity
DYNAMO_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1

# MagiHub: real | mock | bedrock  (mock ⇒ tokens simulated / magihub-mock; bedrock ⇒ tokens real / bedrock vía el adaptador)
MAGIHUB_MODE=mock
MAGIHUB_BASE_URL=http://localhost:4010
# MAGIHUB_USAGE_PATH=/v1/usage
# MAGIHUB_KEYS_SELF_PATH=/v1/keys/self
# MAGIHUB_TIMEOUT_MS=5000

# Caché de identidad (whoami) y frescura de snapshots de usage
# AUTH_CACHE_TTL_SECONDS=300
# USAGE_STALE_SECONDS=300
# USAGE_MAX_WINDOW_DAYS=90

# Secretos (solo Lambda): JSON plano mezclado en process.env al cold start
# APP_SECRET_ARN=arn:aws:secretsmanager:...

# Réplica analítica (projector/migrator). En Lambda: DB_SECRET_ARN (secreto RDS {host,port,username,password,dbname}).
# DB_SECRET_ARN=arn:aws:secretsmanager:...
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=magicode
DB_SSL=false

# Modo demo sin login (nunca en production): sin Authorization se usa esta key de demo.
DEMO_OPEN_ACCESS=true
DEMO_API_KEY=mh_demo_walter

# Entornos cuyo Deployment success cuenta como "desplegado" (embudo y TaskListItem.deployed); staging no.
DEPLOY_PRODUCTION_ENVIRONMENTS=production,prod
